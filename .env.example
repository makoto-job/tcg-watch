# X (Twitter) API v2 / OAuth 1.0a User Context
# https://developer.x.com/en/portal/dashboard で取得
# アプリの User authentication settings で「Read and write」にすること
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 任意設定
TZ=Asia/Tokyo
# 1回の投稿で載せる順位数（デフォルト3）
TOP_N=3
# スレッド形式(thread) か 単発(single) か
POST_STYLE=thread

# --- 他ユーザーのツイート収集（任意・X API Basic $200/月 以上が必要）---
# 無料枠では読み取り不可のため既定は無効。有効化する場合のみ true にする
X_READ_ENABLED=false
X_BEARER_TOKEN=

# --- 小売店の商品検索API（任意・無くても他の小売店ソースは動く）---
# Yahoo!ショッピング 商品検索(v3) API の Client ID（アプリケーションID）。
# 無料。https://e.developer.yahoo.co.jp/dashboard/ にログイン →「アプリケーションを新規開発」
#   利用者情報=個人 / 種類=サーバーサイド（Yahoo! ID連携 v2 を利用しない）
# で作ると即発行される。設定後 config/shop-sources.json の
# yahoo-shopping-tcg-preorder を enabled:true にすると有効になる（未設定ならそのサイトは自動スキップ）。
YAHOO_APP_ID=

# --- モバイルアプリ(PWA)が読むフィードの公開URL ---
# GitHub Pages 公開後のURL。app/config.js 側でも設定可
FEED_URL=
