# X (Twitter) API v2 / OAuth 1.0a User Context
# https://developer.x.com/en/portal/dashboard で取得
# アプリの User authentication settings で「Read and write」にすること
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 任意設定
TZ=Asia/Tokyo
# 1回の投稿で載せる順位数（デフォルト3）
TOP_N=3
# スレッド形式(thread) か 単発(single) か
POST_STYLE=thread

# --- 他ユーザーのツイート収集（任意・X API Basic $200/月 以上が必要）---
# 無料枠では読み取り不可のため既定は無効。有効化する場合のみ true にする
X_READ_ENABLED=false
X_BEARER_TOKEN=

# --- モバイルアプリ(PWA)が読むフィードの公開URL ---
# GitHub Pages 公開後のURL。app/config.js 側でも設定可
FEED_URL=
